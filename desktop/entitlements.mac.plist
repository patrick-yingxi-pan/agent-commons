<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Generic Electron code embeds V8. The specialized plugin helper keeps
         Electron's separate executable-memory profile. Device entitlements
         stay absent because the desktop permission wall grants no camera,
         microphone, Bluetooth, USB, photo-library, location, or print authority. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
