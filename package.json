{
  "name": "agent-commons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A collaboration platform for people and agents.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "server": "node --watch server/index.ts",
    "model": "node server/model/index.ts",
    "connector": "node connector/relay-connector.ts",
    "start": "node scripts/start.mjs desktop",
    "start:desktop": "node scripts/start.mjs desktop",
    "start:web": "node scripts/start.mjs web",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"contract/**/*.test.ts\" \"server/**/*.test.ts\" \"src/**/*.test.ts\" \"tests/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "e2e": "playwright test",
    "ui:sweep": "node scripts/ui-sweep.mjs",
    "preview": "vite preview",
    "snapshot:save": "node scripts/snapshot.ts save",
    "snapshot:restore": "node scripts/snapshot.ts restore",
    "snapshot:list": "node scripts/snapshot.ts list",
    "snapshot:build": "node scripts/snapshot.ts build",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
