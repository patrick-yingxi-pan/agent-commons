{
  "name": "agent-commons",
  "productName": "Agent Commons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "A collaboration platform for people and agents.",
  "author": "Agent Commons contributors",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "server": "node --watch server/index.ts",
    "model": "node server/model/index.ts",
    "connector": "node connector/relay-connector.ts",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:icons": "node desktop/icons.mjs",
    "start": "electron .",
    "prestart": "node desktop/nativeBuild.mjs",
    "start:desktop": "electron .",
    "prestart:desktop": "node desktop/nativeBuild.mjs",
    "start:desktop:server": "node scripts/start.mjs desktop",
    "start:web": "node scripts/start.mjs web",
    "desktop:package": "node desktop/package.mjs",
    "desktop:smoke": "node desktop/smoke.mjs",
    "desktop:smoke:mcp-effects": "node desktop/contributionMcpSmoke.mjs",
    "desktop:smoke:routine-mcp": "node desktop/routineMcpSmoke.mjs",
    "desktop:verify": "npm run desktop:package && npm run desktop:smoke && npm run desktop:smoke:mcp-effects && npm run desktop:smoke:routine-mcp",
    "desktop:release:mac": "node desktop/release.mjs",
    "desktop:release:mac:finalize": "node desktop/release-set.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=4 \"contract/**/*.test.ts\" \"desktop/**/*.test.ts\" \"scripts/**/*.test.ts\" \"server/**/*.test.ts\" \"src/**/*.test.ts\" \"tests/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "e2e": "playwright test",
    "ui:sweep": "node scripts/ui-sweep.mjs",
    "preview": "vite preview",
    "snapshot:save": "node scripts/snapshot.ts save",
    "snapshot:restore": "node scripts/snapshot.ts restore",
    "snapshot:list": "node scripts/snapshot.ts list",
    "snapshot:build": "node scripts/snapshot.ts build",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@zip.js/zip.js": "2.12.0",
    "ajv": "8.20.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "png2icons": "^2.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
